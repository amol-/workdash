.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checker caches
.mypy_cache/
.pyre/
.pytype/

# Local environment and configuration
.env
.env.*
*.local

# Logs and runtime output
*.log

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
